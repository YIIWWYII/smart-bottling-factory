AI_CENTER_PORT=8091
AI_CENTER_DATA_DIR=D:\HarmonyOS-Dev\Data\ai-center
PRODUCTION_BACKEND_BASE_URL=http://127.0.0.1:8088/hdc/api
# Must match factory.ai.service-token in the Spring Boot backend.
# The factory-demo profile defaults to this local development token.
PRODUCTION_BACKEND_SERVICE_TOKEN=dev-ai-service-token

# JSON object keyed by bearer token. Leave empty to use built-in LOCAL_DEMO,
# DISPLAY_DEMO, WORKSTATION_DEMO and REVIEW_DEMO classroom tokens.
AI_CENTER_AUTH_TOKENS=

# LOCAL_DEMO is safe for classroom/demo use and does not call an external model.
# For a real model, use an OpenAI-compatible provider endpoint.
AI_PROVIDER=LOCAL_DEMO
AI_MODEL_NAME=local-demo-assistant
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
AI_REQUEST_TIMEOUT_SECONDS=12
AI_RETRY_COUNT=1
AI_STREAMING_ENABLED=true

AI_EMBEDDING_MODEL=local-demo-embedding
AI_VECTOR_STORE_TYPE=LOCAL_DEMO_MEMORY
AI_VECTOR_STORE_URL=
AI_RAG_TOP_K=5
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=120
AI_KNOWLEDGE_INDEX_ENABLED=true
