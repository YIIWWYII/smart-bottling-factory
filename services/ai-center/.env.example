AI_CENTER_PORT=8091
PRODUCTION_BACKEND_BASE_URL=http://127.0.0.1:8088/hdc/api

# LOCAL_DEMO is safe for classroom/demo use and does not call an external model.
# For a real model, use an OpenAI-compatible provider endpoint.
AI_PROVIDER=LOCAL_DEMO
AI_MODEL_NAME=local-demo-assistant
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
AI_REQUEST_TIMEOUT_SECONDS=12
AI_RETRY_COUNT=1
AI_STREAMING_ENABLED=true

AI_EMBEDDING_MODEL=local-demo-embedding
AI_VECTOR_STORE_TYPE=LOCAL_DEMO_MEMORY
AI_VECTOR_STORE_URL=
AI_RAG_TOP_K=5
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=120
AI_KNOWLEDGE_INDEX_ENABLED=true
